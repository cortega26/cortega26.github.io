# Tooltician site environment template (plan 002).
# Copy to `.env` and fill in real values. Never commit `.env`.
# Key set covers `import.meta.env.*` references in `src/` (names only, no live values).
PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
# Safe to set locally: public/assets/js/analytics-guard.js disables GA4 on any host other than
# tooltician.com / www.tooltician.com, so `npm run dev` / `npm run preview` send no hits.
