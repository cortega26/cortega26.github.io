{
  "name": "tooltician-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/fetch-github-stats.js && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:prod": "node scripts/check-production.mjs",
    "test": "node tests/run.js && node tests/analytics-service-funnel.mjs && node tests/analytics-guard.mjs && node tests/run.js --built && node tests/sitemap-i18n.mjs && node test-htw-snapshot.mjs && node test-behavioral.mjs",
    "test:htw": "node test-htw-snapshot.mjs",
    "test:links": "node scripts/check-links-seo.js",
    "astro": "astro",
    "support:dev": "astro dev --root support",
    "support:build": "astro build --root support",
    "support:check": "astro check --root support",
    "support:test": "npm run support:test:unit && npm run support:test:dist",
    "support:test:unit": "node --test support/tests/unit.test.ts",
    "support:test:dist": "node --test support/tests/artifact.test.ts",
    "support:verify": "npm run support:check && npm run support:test:unit && npm run support:build && npm run support:test:dist",
    "support:preview": "astro preview --root support --port 4331",
    "support:e2e": "node support/tests/browser.mjs",
    "support:release-check": "node support/release-check.ts",
    "support:e2e:release": "node support/tests/release-browser.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/sitemap": "^3.2.0",
    "@playwright/test": "^1.60.0",
    "astro": "^7.1.0",
    "typescript": "^6.0.3"
  }
}
