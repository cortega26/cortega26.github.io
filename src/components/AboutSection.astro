---
interface Props { lang: 'en' | 'es'; }
const { lang } = Astro.props;

const SVG_USERS   = '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>';
const SVG_PACKAGE = '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m7.5 4.27 9 5.15"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>';
const SVG_GEAR    = '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>';

const en = {
  eyebrow: 'Who you work with', title: 'You work directly with Carlos — the person who scopes, builds, and hands off the system.',
  cvLabel: 'Download CV',
  intro: 'Tooltician is not an agency front hiding an anonymous delivery team. I am Carlos Ortega: I read the first note, ask the uncomfortable scoping questions, write the code, review the failure modes, and hand the system over. That direct accountability is part of the product.',
  workStyle: 'My goal is not to make you dependent on me. I prefer explicit tradeoffs, visible progress, and delivery notes that let the next person run, debug, and extend the system without needing the original author on a call.',
  trajectoryLabel: 'Trajectory',
  milestones: [
    '2021–present · Independent software developer — Python/SQL automation, ETL, scraping, APIs, and internal tools for real operations, published under Tooltician.com.',
    '2025–present · Founder & developer, Monedario.cl and Noticiencias.com — a personal-finance platform and an automated publishing pipeline with source verification.',
    '2019–2021 · Atento Chile / Movistar — data analysis for churn and retention, and corporate-account reconciliation of balances, payments, and discrepancies.',
  ],
  cards: [
    { title: 'Where I add the most value', icon: SVG_USERS, items: ['Recurring operational work already costs time, attention, or review risk.', 'A script, spreadsheet, collector, reconciliation, or internal process has become fragile or person-dependent.', 'You need a bounded system delivered by one accountable builder, not an open-ended product team.'] },
    { title: 'What I personally own', icon: SVG_PACKAGE, items: ['Scoping the workflow, constraints, failure modes, and success criteria before implementation.', 'The build itself, including tests, observability, pragmatic tradeoffs, and the awkward edge cases.', 'The handoff: README, operating notes, setup steps, and the failure points worth watching.'] },
    { title: 'Why the handoff matters', icon: SVG_GEAR, items: ['The system should still make sense when I am not in the room.', 'Progress and assumptions stay inspectable instead of living in status calls or private memory.', 'The default outcome is documented ownership by your team — not a permanent dependency on Tooltician.'] },
  ],
};

const es = {
  eyebrow: 'Con quién trabajas', title: 'Trabajas directamente con Carlos — quien acota, construye y traspasa el sistema.',
  cvLabel: 'Descargar CV',
  intro: 'Tooltician no es una fachada de agencia detrás de un equipo anónimo. Soy Carlos Ortega: leo el primer mensaje, hago las preguntas incómodas de alcance, escribo el código, reviso los modos de falla y hago el traspaso. Esa responsabilidad directa es parte del producto.',
  workStyle: 'Mi objetivo no es volverte dependiente de mí. Prefiero tradeoffs explícitos, progreso visible y notas de entrega que permitan a la siguiente persona operar, depurar y extender el sistema sin necesitar al autor original en una llamada.',
  trajectoryLabel: 'Trayectoria',
  milestones: [
    '2021–actualidad · Desarrollador de software independiente — automatización Python/SQL, ETL, scraping, APIs y herramientas internas para operaciones reales, publicado bajo Tooltician.com.',
    '2025–actualidad · Fundador y desarrollador, Monedario.cl y Noticiencias.com — plataforma de finanzas personales y pipeline de publicación automatizada con verificación de fuentes.',
    '2019–2021 · Atento Chile / Movistar — analítica de churn y retención, y conciliación de saldos, pagos y discrepancias de cuentas corporativas.',
  ],
  cards: [
    { title: 'Dónde aporto más valor', icon: SVG_USERS, items: ['Trabajo operativo recurrente ya está costando tiempo, atención o riesgo de revisión.', 'Un script, planilla, colector, conciliación o proceso interno se volvió frágil o dependiente de una persona.', 'Necesitas un sistema acotado entregado por una persona responsable, no un equipo de producto abierto.'] },
    { title: 'Qué asumo personalmente', icon: SVG_PACKAGE, items: ['Acotar el flujo, las restricciones, los modos de falla y los criterios de éxito antes de implementar.', 'La construcción: pruebas, observabilidad, tradeoffs pragmáticos y esos edge cases incómodos que suelen aparecer tarde.', 'El traspaso: README, notas operativas, pasos de setup y puntos de falla que conviene vigilar.'] },
    { title: 'Por qué importa el traspaso', icon: SVG_GEAR, items: ['El sistema debería seguir teniendo sentido cuando yo no esté en la sala.', 'El progreso y los supuestos quedan inspeccionables en vez de vivir en llamadas de estado o memoria privada.', 'El resultado por defecto es ownership documentado de tu equipo — no dependencia permanente de Tooltician.'] },
  ],
};

const c = lang === 'en' ? en : es;
const cvHref =
  lang === 'en'
    ? '/assets/docs/carlos-ortega-resume.pdf'
    : '/assets/docs/carlos-ortega-resume-es.pdf';
---
<section class="section section--alt" id="about">
  <div class="container">
    <div class="section-header section-header--center">
      <span class="section-eyebrow reveal">{c.eyebrow}</span>
      <h2 class="section-title reveal">{c.title}</h2>
      <div class="divider reveal"></div>
      <p class="section-subtitle reveal">{c.intro}</p>
      <p class="about-workstyle reveal reveal-delay-1">{c.workStyle}</p>
    </div>
    <div class="grid-3">
      {c.cards.map((card, i) => (
        <article class={`card-glass reveal reveal-delay-${(i % 2) + 1}`}>
          <div class="component-icon" set:html={card.icon}></div>
          <h3 class="card-title">{card.title}</h3>
          <ul class="about-list">
            {card.items.map(item => <li>{item}</li>)}
          </ul>
        </article>
      ))}
    </div>
    <div class="about-trajectory reveal">
      <p class="about-trajectory-label">{c.trajectoryLabel}</p>
      <ul class="about-trajectory-list">
        {c.milestones.map(milestone => <li>{milestone}</li>)}
      </ul>
    </div>
    <div class="about-cta reveal">
      <a class="btn btn-ghost" href={cvHref} target="_blank" rel="noopener noreferrer" data-track="cta_download_cv" data-track-loc="about" data-cv-download>{c.cvLabel}</a>
    </div>
  </div>
</section>

<style>
.about-list { display: flex; flex-direction: column; gap: 0.6rem; }
.about-list li {
  font-size: var(--fs-sm);
  color: var(--clr-text-muted); line-height: 1.55;
  padding-left: 1rem; position: relative;
}
.about-list li::before {
  content: '›'; position: absolute; left: 0;
  color: var(--clr-accent); font-weight: 700;
}
.about-workstyle {
  font-size: var(--fs-sm);
  color: var(--clr-text-muted);
  line-height: 1.7;
  max-width: 60ch;
  margin-top: 0.5rem;
}
.about-cta {
  display: flex;
  justify-content: center;
  margin-top: 1.75rem;
}
.about-trajectory {
  margin-top: 2rem;
  padding: 1rem 1.25rem;
  border: 1px solid var(--clr-border);
  border-radius: var(--radius-md);
  background: rgba(255, 255, 255, 0.015);
}
.about-trajectory-label {
  font-family: var(--ff-label);
  font-size: 0.68rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--clr-text-faint);
  margin-bottom: 0.6rem;
}
.about-trajectory-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}
.about-trajectory-list li {
  font-size: var(--fs-sm);
  color: var(--clr-text-muted);
  line-height: 1.55;
  padding-left: 1rem;
  position: relative;
}
.about-trajectory-list li::before {
  content: '›'; position: absolute; left: 0;
  color: var(--clr-accent); font-weight: 700;
}
</style>
