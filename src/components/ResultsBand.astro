---
interface Props {
  lang: 'en' | 'es';
}
const { lang } = Astro.props;

const en = {
  label: 'What this looks like in practice',
  caption: 'Proof should answer what changed for the operator, not only which stack was used.',
  cases: [
    {
      problem: 'Private ordering was being coordinated informally.',
      outcome: 'A live storefront now handles 100+ SKUs and daily orders in production.',
      proof: 'See the live business →',
      href: 'https://elrincondeebano.com',
    },
    {
      problem: 'Chilean public data arrives fragmented and can change upstream without warning.',
      outcome: 'chile-hub turns it into reproducible, validated data builds with loud-failing checks.',
      proof: 'Inspect the pipeline →',
      href: 'https://github.com/cortega26/chile-hub',
    },
    {
      problem: 'A reconciliation should never look correct when the underlying data does not match.',
      outcome: 'bankrecon stops on mismatches and preserves a traceable record of every run.',
      proof: 'Inspect the package →',
      href: 'https://pypi.org/project/bankrecon/',
    },
  ],
};

const es = {
  label: 'Cómo se ve esto en la práctica',
  caption: 'La prueba debería responder qué cambió para quien opera el proceso, no solo qué stack se usó.',
  cases: [
    {
      problem: 'Los pedidos privados se coordinaban de forma informal.',
      outcome: 'Una tienda activa gestiona hoy más de 100 SKUs y pedidos diarios en producción.',
      proof: 'Ver el negocio activo →',
      href: 'https://elrincondeebano.com',
    },
    {
      problem: 'Los datos públicos chilenos llegan fragmentados y pueden cambiar aguas arriba sin aviso.',
      outcome: 'chile-hub los convierte en builds reproducibles y validados con controles que fallan de forma visible.',
      proof: 'Inspeccionar el pipeline →',
      href: 'https://github.com/cortega26/chile-hub',
    },
    {
      problem: 'Una conciliación nunca debería parecer correcta cuando los datos de origen no cuadran.',
      outcome: 'bankrecon se detiene ante diferencias y conserva una traza verificable de cada ejecución.',
      proof: 'Inspeccionar el paquete →',
      href: 'https://pypi.org/project/bankrecon/',
    },
  ],
};

const c = lang === 'en' ? en : es;
---
<section class="results-band" id="proof" aria-label={c.label}>
  <div class="container">
    <div class="results-band__inner reveal">
      <p class="results-band__label">{c.label}</p>
      <div class="results-band__grid">
        {c.cases.map(item => (
          <article class="results-band__case">
            <p class="results-band__problem">{item.problem}</p>
            <p class="results-band__outcome">{item.outcome}</p>
            <a
              class="results-band__verify"
              href={item.href}
              target="_blank"
              rel="noopener noreferrer"
              data-track="proof_verify"
              data-track-loc="results_band"
              data-proof-click
            >{item.proof}</a>
          </article>
        ))}
      </div>
      <p class="results-band__caption">{c.caption}</p>
    </div>
  </div>
</section>

<style>
  .results-band {
    padding: 2.75rem 0;
    border-top: 1px solid var(--clr-border);
    border-bottom: 1px solid var(--clr-border);
    background:
      linear-gradient(180deg, rgba(196, 160, 74, 0.05), rgba(255, 255, 255, 0.015));
  }

  .results-band__label {
    font-family: var(--ff-label);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--clr-accent);
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .results-band__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .results-band__case {
    padding: 1.2rem 1.25rem;
    border: 1px solid var(--clr-border);
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.025);
  }

  .results-band__problem {
    font-size: 0.82rem;
    line-height: 1.55;
    color: var(--clr-text-faint);
    margin-bottom: 0.6rem;
  }

  .results-band__outcome {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--clr-text);
    font-weight: 600;
    margin-bottom: 0.9rem;
  }

  .results-band__verify {
    font-family: var(--ff-label);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--clr-accent);
    transition: color var(--dur-fast);
  }

  .results-band__verify:hover {
    color: var(--clr-text);
  }

  .results-band__caption {
    text-align: center;
    font-size: 0.82rem;
    color: var(--clr-text-faint);
    line-height: 1.6;
    margin-top: 1.4rem;
  }

  @media (max-width: 760px) {
    .results-band__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
