---
import { engagementCompact, engagementStages, retainerLine } from '../data/pricing';

interface Props { lang: 'en' | 'es'; }
const { lang } = Astro.props;

const SVG_REFRESH  = '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 2v6h-6"/><path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M3 22v-6h6"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/></svg>';
const SVG_SEARCH   = '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>';
const SVG_LAYERS   = '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/><path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/></svg>';
const SVG_GLOBE    = '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>';
const SVG_SHIELD   = '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>';
const en = {
  eyebrow: 'Services', title: 'Six scoped services. One delivery standard.',
  subtitle: 'Each service starts with a concrete operational problem, ends with something your team can run, and states what sits outside the engagement. Fixed scope, visible progress, and a documented handoff.',
  fitLabel: 'Best when:',
  scopeLabel: 'Scope:',
  moreLabel: 'Scope & evidence',
  ctaLabel: 'View service',
  termsLabel: 'Engagement terms →',
  termsHref: '/en/engagement/',
  services: [
    { serviceId: 'automation', icon: SVG_REFRESH, title: 'Python Automation & Data Pipelines', desc: 'Turn recurring reports, ETL steps, and manual data delivery into scheduled, reproducible workflows.', fit: 'Inputs, outputs, owner, cadence, and success criteria can be named.', scope: 'One defined workflow or a coordinated multi-source system; excludes full data-platform programs and ML model development.', examples: [{ name: 'chile-hub', href: 'https://github.com/cortega26/chile-hub' }, { name: 'Jackpot Pipeline', href: 'https://github.com/cortega26/polla' }], href: '/en/services/python-automation/' },
    { serviceId: 'recurring-data', icon: SVG_SEARCH, title: 'Recurring Data Collection', desc: 'Collect public or authorized data repeatedly through resilient scraping and acquisition flows that fail loudly instead of drifting silently.', fit: 'A recurring source feeds operations, analysis, or publishing.', scope: 'Public or authorized sources with a repeatable collection need; excludes access-control bypasses and one-off lead harvesting.', examples: [{ name: 'Jackpot Pipeline', href: 'https://github.com/cortega26/polla' }, { name: 'Noticiencias', href: 'https://github.com/cortega26/noticiencias' }], href: '/en/services/recurring-data-collection/' },
    { serviceId: 'internal-tools', icon: SVG_LAYERS, title: 'Internal Tools & APIs', desc: 'Turn scripts and brittle operator steps into a CLI, internal API, or guided interface a team can use and hand off.', fit: 'Several people touch the workflow, or the original author has become a bottleneck.', scope: 'One known internal workflow; excludes full SaaS products, mobile apps, and open-ended staff augmentation.', examples: [{ name: 'Rutificador', href: 'https://github.com/cortega26/rutificador' }, { name: 'DNSpect', href: 'https://github.com/cortega26/DNSpect' }], href: '/en/services/internal-tools/' },
    { serviceId: 'financial', icon: SVG_SHIELD, title: 'Financial & Audit Systems', desc: 'Build reconciliation and control workflows that stop on mismatches, preserve audit trails, and make review easier.', fit: 'A wrong answer costs more than a slower, explicit check.', scope: 'One defined control flow or coordinated multi-source system; excludes certified audits, tax advice, and full ERP replacement.', examples: [{ name: 'Conciliador Bancario', href: 'https://github.com/cortega26/conciliador_bancario' }, { name: 'Portfolio Manager', href: 'https://github.com/cortega26/portfolio-manager-server' }], href: '/en/services/financial-tooling/' },
    { serviceId: 'web', icon: SVG_GLOBE, title: 'Static Sites & Focused Front Ends', desc: 'Build fast, maintainable public surfaces that explain the work clearly, convert the right lead, and survive handoff.', fit: 'Clarity, performance, and maintainability matter more than decorative marketing.', scope: 'Informational sites, landing pages, bilingual surfaces, and focused front ends; excludes complex SaaS and e-commerce backends.', examples: [{ name: 'Monedario', href: 'https://monedario.cl' }, { name: 'El Rincón de Ébano', href: 'https://elrincondeebano.com' }], href: '/en/services/static-sites/' },
    { serviceId: 'htw', icon: SVG_SHIELD, title: 'Web Technical Hygiene', desc: 'Review and improve security headers, HTTPS, DNS, forms, Search Console, and lightweight monitoring on an existing live site.', fit: 'The site matters commercially, but nobody owns its technical basics.', scope: 'Review, basic hardening, verified fixes, and light monitoring; excludes penetration tests and guarantees of total security.', examples: [{ name: 'DNSpect', href: 'https://github.com/cortega26/DNSpect' }, { name: 'Monedario', href: 'https://monedario.cl' }], href: '/en/services/web-technical-hygiene/' },
  ],
  examplesLabel: 'Evidence:',
  notFitTitle: 'Not the right fit',
  notFitItems: [
    'Open-ended discovery with no concrete workflow already in use.',
    'One-off analysis with no repeating delivery or operational need.',
    'Engagements where the workflow owner has not been identified internally.',
    'Cases where a full-time junior hire is a better economic fit than a scoped contractor.',
  ],
  shapesLabel: 'Engagement shapes',
  shapes: [
    { serviceId: 'automation', name: 'Scoped automation', range: engagementCompact('en', 'automation'), note: 'international delivery', href: '/en/services/python-automation/' },
    { serviceId: 'automation', name: 'Stabilization retainer', range: retainerLine('en', 'automation'), note: 'optional, no lock-in', href: '/en/services/python-automation/#plans' },
    { serviceId: 'htw', name: 'Web hygiene', range: `Diagnostic ${engagementStages('en', 'webHygiene').diagnostic}`, note: 'already priced', href: '/en/services/web-technical-hygiene/' },
    { bookCall: true, name: 'Diagnostic call', range: 'free', note: '15 min', href: 'https://calendly.com/ciortega26' },
  ],
};

const es = {
  eyebrow: 'Servicios', title: 'Seis servicios acotados. Un mismo estándar de entrega.',
  subtitle: 'Cada servicio parte de un problema operativo concreto, termina en algo que tu equipo puede operar y deja claro qué queda fuera. Alcance fijo, avance visible y traspaso documentado.',
  fitLabel: 'Encaja cuando:',
  scopeLabel: 'Alcance:',
  moreLabel: 'Alcance y evidencia',
  ctaLabel: 'Ver servicio',
  services: [
    { serviceId: 'automation', icon: SVG_REFRESH, title: 'Automatización Python y Pipelines de Datos', desc: 'Convierto reportes recurrentes, pasos ETL y entregas manuales de datos en flujos programados y reproducibles.', fit: 'Se pueden nombrar entradas, salidas, responsable, frecuencia y criterios de éxito.', scope: 'Un flujo definido o un sistema coordinado de varias fuentes; no incluye levantar una plataforma de datos completa ni desarrollar modelos de ML.', examples: [{ name: 'chile-hub', href: 'https://github.com/cortega26/chile-hub' }, { name: 'Pipeline de Lotería', href: 'https://github.com/cortega26/polla' }], href: '/es/servicios/automatizacion-python/' },
    { serviceId: 'recurring-data', icon: SVG_SEARCH, title: 'Recolección Recurrente de Datos', desc: 'Recolecto datos públicos o autorizados mediante scraping y flujos de adquisición resilientes que fallan de forma visible en vez de degradarse en silencio.', fit: 'Una fuente recurrente alimenta operaciones, análisis o publicación.', scope: 'Fuentes públicas o autorizadas con una necesidad repetible; no incluye evadir controles de acceso ni recolectar leads por única vez.', examples: [{ name: 'Pipeline de Lotería', href: 'https://github.com/cortega26/polla' }, { name: 'Noticiencias', href: 'https://github.com/cortega26/noticiencias' }], href: '/es/servicios/recoleccion-recurrente-datos/' },
    { serviceId: 'internal-tools', icon: SVG_LAYERS, title: 'Herramientas Internas y APIs', desc: 'Convierto scripts y pasos operativos frágiles en una CLI, API interna o interfaz guiada que un equipo puede usar y traspasar.', fit: 'Varias personas tocan el flujo o el autor original se volvió un cuello de botella.', scope: 'Un flujo interno conocido; no incluye productos SaaS completos, apps móviles ni asignación de personal sin responsabilidades definidas.', examples: [{ name: 'Rutificador', href: 'https://github.com/cortega26/rutificador' }, { name: 'DNSpect', href: 'https://github.com/cortega26/DNSpect' }], href: '/es/servicios/herramientas-internas/' },
    { serviceId: 'financial', icon: SVG_SHIELD, title: 'Sistemas Financieros y de Auditoría', desc: 'Construyo flujos de conciliación y control que se detienen ante diferencias, preservan trazas de auditoría y facilitan la revisión.', fit: 'Una respuesta equivocada cuesta más que una verificación explícita un poco más lenta.', scope: 'Un control definido o un sistema coordinado de varias fuentes; no incluye auditoría certificada, asesoría tributaria ni reemplazar un ERP completo.', examples: [{ name: 'Conciliador Bancario', href: 'https://github.com/cortega26/conciliador_bancario' }, { name: 'Portfolio Manager', href: 'https://github.com/cortega26/portfolio-manager-server' }], href: '/es/servicios/herramientas-financieras/' },
    { serviceId: 'web', icon: SVG_GLOBE, title: 'Sitios Estáticos y Frontends Acotados', desc: 'Construyo superficies públicas rápidas y mantenibles que explican el trabajo con claridad, convierten al lead correcto y sobreviven al traspaso.', fit: 'La claridad, el rendimiento y la mantenibilidad importan más que el marketing decorativo.', scope: 'Sitios informativos, landings, superficies bilingües y frontends enfocados; no incluye backends SaaS o e-commerce complejos.', examples: [{ name: 'Monedario', href: 'https://monedario.cl' }, { name: 'El Rincón de Ébano', href: 'https://elrincondeebano.com' }], href: '/es/servicios/sitios-web/' },
    { serviceId: 'htw', icon: SVG_SHIELD, title: 'Higiene Técnica Web', desc: 'Reviso y mejoro headers de seguridad, HTTPS, DNS, formularios, Search Console y monitoreo liviano en un sitio que ya está publicado.', fit: 'El sitio importa comercialmente, pero nadie es responsable de sus fundamentos técnicos.', scope: 'Revisión, hardening básico, correcciones verificadas y monitoreo liviano; no incluye pentesting ni promesas de seguridad total.', examples: [{ name: 'DNSpect', href: 'https://github.com/cortega26/DNSpect' }, { name: 'Monedario', href: 'https://monedario.cl' }], href: '/es/servicios/higiene-tecnica-web/' },
  ],
  examplesLabel: 'Evidencia:',
  notFitTitle: 'No es el encaje correcto',
  notFitItems: [
    'Discovery abierto sin un flujo concreto ya en uso.',
    'Análisis aislado sin necesidad de entrega recurrente u operacional.',
    'Proyectos donde el dueño del flujo no está identificado internamente.',
    'Casos donde contratar un junior de planta es mejor opción económica que un contratista acotado.',
  ],
  shapesLabel: 'Modalidades de trabajo',
  shapes: [
    { serviceId: 'automation', name: 'Automatización acotada', range: engagementCompact('es', 'automation'), note: 'tarifa Chile / LATAM', href: '/es/servicios/automatizacion-python/' },
    { serviceId: 'automation', name: 'Retainer de estabilización', range: retainerLine('es', 'automation'), note: 'opcional, sin permanencia', href: '/es/servicios/automatizacion-python/#plans' },
    { serviceId: 'htw', name: 'Higiene técnica web', range: `Diagnóstico ${engagementStages('es', 'webHygiene').diagnostic}`, note: 'ya con precio', href: '/es/servicios/higiene-tecnica-web/' },
    { bookCall: true, name: 'Llamada de diagnóstico', range: 'gratis', note: '15 min', href: 'https://calendly.com/ciortega26' },
  ],
  termsLabel: 'Condiciones de trabajo →',
  termsHref: '/es/engagement/',
};

const c = lang === 'en' ? en : es;

// Concrete deliverable per service — anchors perceived value to a tangible
// outcome rather than an abstract capability. Keyed by service title.
const serviceResults: Record<string, string> = lang === 'en' ? {
  'Python Automation & Data Pipelines': 'A tested pipeline with a schedule, logging, alerts, structured outputs, README, and runbook.',
  'Recurring Data Collection': 'A re-runnable collector with proper logs and repair notes.',
  'Internal Tools & APIs': 'A deployed CLI, API, or interface with validation, tests, operating docs, and handoff.',
  'Financial & Audit Systems': 'A fail-closed control flow with deterministic outputs, validation rules, and audit-grade logs.',
  'Static Sites & Focused Front Ends': 'A deployed, fast, indexable surface with forms, analytics, and maintenance documentation.',
  'Web Technical Hygiene': 'A before/after report with verified fixes, clear priorities, and an optional monitoring plan.',
} : {
  'Automatización Python y Pipelines de Datos': 'Un pipeline probado con programación, logs, alertas, salidas estructuradas, README y runbook.',
  'Recolección Recurrente de Datos': 'Un colector reejecutable con logs adecuados y notas de reparación.',
  'Herramientas Internas y APIs': 'Una CLI, API o interfaz desplegada con validación, pruebas, documentación operativa y traspaso.',
  'Sistemas Financieros y de Auditoría': 'Un flujo fail-closed con salidas deterministas, reglas de validación y logs aptos para auditoría.',
  'Sitios Estáticos y Frontends Acotados': 'Una superficie desplegada, rápida e indexable, con formularios, analítica y documentación de mantención.',
  'Higiene Técnica Web': 'Un reporte antes/después con correcciones verificadas, prioridades claras y un plan opcional de monitoreo.',
};
const resultLabel = lang === 'en' ? 'Deliverable:' : 'Entregable:';
---
<section class="section" id="services">
  <div class="container">
    <div class="section-header section-header--center">
      <span class="section-eyebrow reveal">{c.eyebrow}</span>
      <h2 class="section-title reveal">{c.title}</h2>
      <div class="divider reveal"></div>
      <p class="section-subtitle reveal">{c.subtitle}</p>
    </div>
    <div class="services-grid">
      {c.services.map((svc, i) => (
        <article data-service-id={svc.serviceId} class={`card-glass svc-card ${svc.href ? 'svc-card--linked' : ''} reveal reveal-delay-${(i % 2) + 1}`}>
          <div class="component-icon" set:html={svc.icon}></div>
          <h3 class="card-title">{svc.title}</h3>
          <p class="svc-desc">{svc.desc}</p>
          <p class="svc-fit"><span>{c.fitLabel}</span> {svc.fit}</p>
          <p class="svc-scope svc-desktop-detail"><span>{c.scopeLabel}</span> {svc.scope}</p>
          {serviceResults[svc.title] && (
            <p class="svc-result"><span>{resultLabel}</span> {serviceResults[svc.title]}</p>
          )}
          {svc.href && (
            <a class="btn btn-ghost btn-sm svc-inline-cta" data-service-engage href={svc.href}>
              {c.ctaLabel}<span class="visually-hidden">: {svc.title}</span>
            </a>
          )}
          <p class="svc-examples-label svc-desktop-detail">{c.examplesLabel}</p>
          <div class="svc-examples svc-desktop-detail">
            {svc.examples.map(ex => (
              <a class="badge badge-accent" data-portfolio-click href={ex.href} target="_blank" rel="noopener noreferrer">{ex.name}</a>
            ))}
          </div>
          <details class="svc-mobile-detail">
            <summary>{c.moreLabel}</summary>
            <p class="svc-scope"><span>{c.scopeLabel}</span> {svc.scope}</p>
            <p class="svc-examples-label">{c.examplesLabel}</p>
            <div class="svc-examples">
              {svc.examples.map(ex => (
                <a class="badge badge-accent" data-portfolio-click href={ex.href} target="_blank" rel="noopener noreferrer">{ex.name}</a>
              ))}
            </div>
          </details>
        </article>
      ))}
    </div>

    <div class="not-fit-strip reveal">
      <p class="not-fit-title">{c.notFitTitle}</p>
      <ul class="not-fit-list">
        {c.notFitItems.map(item => (
          <li>{item}</li>
        ))}
      </ul>
    </div>

    <div class="shapes-strip reveal">
      <span class="shapes-label">{c.shapesLabel}</span>
      <div class="shapes-list">
        {c.shapes.map(s => (
          <a class="shape-chip" data-service-id={s.serviceId} data-service-engage data-book-call={s.bookCall ? '' : undefined} data-track-loc={s.bookCall ? 'services_shapes' : undefined} href={s.href}>
            <span class="shape-name">{s.name}</span>
            <span class="shape-range">{s.range}</span>
            <span class="shape-note">{s.note}</span>
          </a>
        ))}
      </div>
    </div>

    <div class="terms-link-row reveal">
      <a class="terms-link" href={c.termsHref}>{c.termsLabel}</a>
    </div>
  </div>
</section>

<style>
.services-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: var(--sp-6);
}
.svc-desc { font-size: 0.87rem; color: var(--clr-text-muted); line-height: 1.55; margin-bottom: 1rem; flex: 1; }
.svc-fit {
  font-size: 0.78rem;
  line-height: 1.6;
  color: var(--clr-text-faint);
  margin-bottom: 0.85rem;
}
.svc-fit span {
  color: var(--clr-text);
  font-weight: 600;
}
.svc-scope {
  font-size: 0.77rem;
  line-height: 1.6;
  color: var(--clr-text-faint);
  margin-bottom: 0.85rem;
  padding: 0.6rem 0.75rem;
  border: 1px solid var(--clr-border);
  border-radius: var(--radius-sm);
  background: rgba(255, 255, 255, 0.015);
}
.svc-scope span {
  color: var(--clr-text-muted);
  font-weight: 600;
}
.svc-result {
  font-size: 0.78rem;
  line-height: 1.6;
  color: var(--clr-text-muted);
  margin-bottom: 0.85rem;
  padding: 0.6rem 0.75rem;
  border-left: 2px solid var(--clr-accent);
  background: rgba(196, 160, 74, 0.05);
  border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
}
.svc-result span {
  color: var(--clr-accent);
  font-family: var(--ff-label);
  font-weight: 600;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  font-size: 0.68rem;
  margin-right: 0.25rem;
}
.svc-examples-label { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--clr-text-faint); margin-bottom: 0.5rem; }
.svc-examples { display: flex; flex-wrap: wrap; gap: 0.4rem; }
.svc-card { display: flex; flex-direction: column; }
.svc-card--linked {
  border-color: rgba(196, 160, 74, 0.18);
  background: linear-gradient(180deg, rgba(196, 160, 74, 0.05), rgba(255, 255, 255, 0.03));
}
.svc-inline-cta {
  align-self: flex-start;
  margin-bottom: 1rem;
}
.svc-mobile-detail { display: none; }

.not-fit-strip {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 0.75rem 1.5rem;
  margin-top: 2rem;
  padding: 1rem 1.25rem;
  border: 1px solid var(--clr-border);
  border-radius: var(--radius-md);
  background: rgba(255, 255, 255, 0.015);
}

.not-fit-title {
  font-family: var(--ff-label);
  font-size: 0.68rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--clr-text-faint);
  white-space: nowrap;
}

.not-fit-list {
  display: flex;
  flex-wrap: wrap;
  gap: 0.45rem 1.5rem;
  flex: 1;
  list-style: none;
  padding: 0;
  margin: 0;
}

.not-fit-list li {
  position: relative;
  padding-left: 0.85rem;
  font-size: 0.83rem;
  color: var(--clr-text-faint);
  line-height: 1.55;
}

.not-fit-list li::before {
  content: '×';
  position: absolute;
  left: 0;
  color: var(--clr-text-faint);
  opacity: 0.5;
  font-weight: 700;
  font-size: 0.72rem;
}

.shapes-strip {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 0.75rem 1.5rem;
  margin-top: 2rem;
  padding: 1rem 1.25rem;
  border: 1px solid var(--clr-border);
  border-radius: var(--radius-md);
  background: rgba(255, 255, 255, 0.02);
}

.shapes-label {
  font-family: var(--ff-label);
  font-size: 0.68rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--clr-text-faint);
  white-space: nowrap;
}

.shapes-list {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  flex: 1;
}

.shape-chip {
  display: inline-flex;
  align-items: baseline;
  gap: 0.4rem;
  padding: 0.35rem 0.75rem;
  border: 1px solid var(--clr-border);
  border-radius: var(--radius-sm);
  background: var(--clr-surface);
  transition: border-color 150ms, background 150ms;
  text-decoration: none;
}

.shape-chip:hover {
  border-color: rgba(196, 160, 74, 0.3);
  background: rgba(196, 160, 74, 0.05);
}

.shape-name {
  font-size: 0.84rem;
  font-weight: 600;
  color: var(--clr-text);
}

.shape-range {
  font-family: var(--ff-label);
  font-size: 0.72rem;
  font-weight: 600;
  color: var(--clr-accent);
  letter-spacing: 0.02em;
}

.shape-note {
  font-size: 0.72rem;
  color: var(--clr-text-faint);
}

.terms-link-row {
  margin-top: 1.25rem;
  display: flex;
  justify-content: flex-end;
}

.terms-link {
  font-family: var(--ff-label);
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--clr-text-faint);
  text-decoration: none;
  transition: color 150ms;
}

.terms-link:hover {
  color: var(--clr-accent);
}

@media (max-width: 980px) {
  .services-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 720px) {
  .services-grid {
    grid-template-columns: 1fr;
  }
  .svc-card { padding: 1.15rem; }
  .svc-desc { font-size: 0.9rem; margin-bottom: 0.75rem; }
  .svc-fit, .svc-result { font-size: 0.84rem; }
  .svc-desktop-detail { display: none; }
  .svc-mobile-detail {
    display: block;
    margin-top: 0.1rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--clr-border);
  }
  .svc-mobile-detail summary {
    color: var(--clr-accent);
    cursor: pointer;
    font-family: var(--ff-label);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.05em;
