---
import type { Website } from '../data/websites';

interface Props { site: Website; lang: 'es' | 'en' }
const { site, lang } = Astro.props;
const es = lang === 'es';
---
<div class={"site-shot site-shot--" + site.id} aria-hidden="true">
  <div class="site-shot__browser">
    <div class="site-shot__dots"><i></i><i></i><i></i></div>
    <span class="site-shot__url">{site.domain}</span>
    <span class="site-shot__secure">↗</span>
  </div>


  {site.id === 'noticiencias' && (
    <div class="shot-news">
      <div class="shot-news__nav">
        <b>Noticiencias</b>
        <span>{es ? 'Ciencia · Tecnología · Archivo' : 'Science · Technology · Archive'}</span>
      </div>
      <div class="shot-news__edition">
        <span>{es ? 'PORTADA · 17 OCTUBRE 2026' : 'FRONT PAGE · 17 OCTOBER 2026'}</span>
        <span>{es ? 'FUENTES IDENTIFICADAS' : 'SOURCED REPORTING'}</span>
      </div>
      <div class="shot-news__headline">
        <strong>{es ? 'Ciencia y tecnología para leer con criterio.' : 'Science and technology, in context.'}</strong>
        <p>{es ? 'Hallazgos, dudas y consecuencias de cada historia.' : 'Discoveries, questions and their implications.'}</p>
      </div>
      <div class="shot-news__feature">
        <img src="https://noticiencias.com/_astro/2026-10-17-neandertal-herido-y-cuidado-senal-de-empatia-hace-75-000-anos.dOSBiH_p_Z2aPWnO.webp" width="440" height="300" loading="lazy" decoding="async" alt="" />
        <div class="shot-news__feature-copy">
          <small>{es ? 'ARQUEOLOGÍA · 17 OCT' : 'ARCHAEOLOGY · 17 OCT'}</small>
          <b>{es ? '¿Qué ocurrió con el neandertal de Shanidar?' : 'What happened to the Shanidar Neanderthal?'}</b>
          <span>{es ? 'FUENTE · 404 MEDIA' : 'SOURCE · 404 MEDIA'}</span>
        </div>
      </div>
      <div class="shot-news__bottom">
        <span>{es ? 'DE ESTA EDICIÓN' : 'IN THIS EDITION'}</span>
        <span>{es ? 'Investigación · Ciencia · Tecnología' : 'Research · Science · Technology'}</span>
      </div>
    </div>
  )}

  {site.id === 'monedario' && (
    <div class="shot-money">
      <div class="shot-money__nav">
        <div class="shot-money__brand">
          <span class="shot-money__mark"><i></i><i></i><i></i></span>
          <b>Monedario</b>
        </div>
        <span>{es ? 'Guías　 Calculadoras　 Glosario' : 'Guides　 Calculators　 Glossary'}</span>
      </div>
      <div class="shot-money__content">
        <div class="shot-money__hero">
          <span>{es ? 'FINANZAS PERSONALES · CHILE' : 'PERSONAL FINANCE · CHILE'}</span>
          <strong>{es ? <>Decisiones de <em>plata</em> en Chile.</> : <>Make better <em>money</em> decisions.</>}</strong>
          <p>{es ? 'Basadas en matemáticas y la ley vigente.' : 'Based on mathematics and current law.'}</p>
        </div>
        <div class="shot-money__links">
          <span>{es ? 'Calcular sueldo líquido' : 'Calculate net salary'} <b>→</b></span>
          <span>{es ? 'Simular finiquito' : 'Estimate severance'} <b>→</b></span>
          <span>{es ? 'Convertir UF' : 'Convert UF'} <b>→</b></span>
        </div>
      </div>
      <div class="shot-money__indicators">
        <div class="shot-money__indicator"><small>UF</small><b>UF ↔ CLP</b></div>
        <div class="shot-money__indicator"><small>UTM</small><b>{es ? 'Impuestos' : 'Tax'}</b></div>
        <div class="shot-money__indicator"><small>{es ? 'DÓLAR OBS.' : 'USD / CLP'}</small><b>{es ? 'Indicadores' : 'Indicators'}</b></div>
      </div>
      <div class="shot-money__foot">{es ? 'Sin publicidad · Sin registro · Fuentes oficiales' : 'Ad-free · No registration · Official sources'}</div>
    </div>
  )}

  {site.id === 'ebano' && (
    <div class="shot-shop">
      <div class="shot-shop__nav"><b>El Rincón de Ébano</b><span>{es ? 'Mi carrito' : 'My cart'} <i>2</i></span></div>
      <div class="shot-shop__copy"><small>{es ? 'COMERCIO DE PROXIMIDAD' : 'NEIGHBORHOOD SHOP'}</small><strong>{es ? '¿Qué te falta hoy?' : 'What do you need today?'}</strong><span class="shot-shop__search">{es ? 'Buscar en el catálogo' : 'Search the catalog'} <span>⌕</span></span></div>
      <div class="shot-shop__products">
        <div class="shot-shop__product"><img src="https://www.elrincondeebano.com/assets/images/variants/w400/images/despensa/Harina%20Mont%20Blanc%201Kg.webp" width="130" height="145" loading="lazy" decoding="async" alt="" /><b>{es ? 'Harina' : 'Flour'}</b><span>+</span></div>
        <div class="shot-shop__product"><img src="https://www.elrincondeebano.com/assets/images/variants/w400/images/limpieza_y_aseo/Nova%20Cl%C3%A1siva%203x12m.webp" width="130" height="145" loading="lazy" decoding="async" alt="" /><b>{es ? 'Hogar' : 'Home'}</b><span>+</span></div>
      </div>
    </div>
  )}

  {site.id === 'casabea' && (
    <div class="shot-bakery">
      <div class="shot-bakery__nav"><b>Casa Bea<span>®</span></b><small>{es ? 'HECHO EN MACUL' : 'HANDMADE IN MACUL'}</small></div>
      <div class="shot-bakery__body">
        <div class="shot-bakery__copy"><small>{es ? 'RECIÉN HORNEADOS' : 'FRESHLY BAKED'}</small><strong>{es ? 'Un antojo hecho a mano.' : 'Handmade, made to share.'}</strong><p>{es ? 'Roles de canela artesanales.' : 'Artisan cinnamon rolls.'}</p><span>{es ? 'Ver sabores' : 'Explore flavors'} →</span></div>
        <img src="https://casabea.cl/_astro/rol-tradicional.DDi5ZnEc_ZgBTTW.jpg" width="400" height="370" loading="lazy" decoding="async" alt="" />
      </div>
      <div class="shot-bakery__foot"><span>TRADICIONAL</span><span>AMERICANO</span><span>NUTELLA</span></div>
    </div>
  )}

  {site.id === 'nohemi' && (
    <div class="shot-art">
      <div class="shot-art__nav"><span>NOHEMI PALENCIA</span><small>{es ? 'OBRA / TRAYECTORIA' : 'WORK / BIOGRAPHY'}</small></div>
      <div class="shot-art__paintings">
        <div class="shot-art__painting"><img src="https://nohemipalencia.com/assets/obras/gallery/guardiana-480.webp" width="260" height="340" loading="lazy" decoding="async" alt="" /></div>
        <div class="shot-art__painting shot-art__painting--second"><img src="https://nohemipalencia.com/assets/obras/gallery/princesa-onirica-480.webp" width="260" height="340" loading="lazy" decoding="async" alt="" /></div>
      </div>
      <div class="shot-art__caption"><small>{es ? 'ARTE CONTEMPORÁNEO' : 'CONTEMPORARY ART'}</small><strong>{es ? 'Rostros oníricos.' : 'Dreamlike portraits.'}</strong></div>
    </div>
  )}

  {site.id === 'chile-hub' && (
    <div class="shot-data">
      <div class="shot-data__nav"><b>chile<span>-hub</span></b><small>OPEN DATA / CHILE</small></div>
      <div class="shot-data__heading"><small>{es ? 'DATOS PÚBLICOS, UTILIZABLES' : 'PUBLIC DATA, READY TO USE'}</small><strong>{es ? 'De datos dispersos a información usable.' : 'From fragmented data to usable information.'}</strong></div>
      <div class="shot-data__dashboard">
        <div><small>{es ? 'CAPAS' : 'LAYERS'}</small><b>22</b><span>{es ? 'en el catálogo' : 'published'}</span></div>
        <div><small>{es ? 'COMUNAS' : 'DISTRICTS'}</small><b>346</b><span>{es ? 'normalizadas' : 'normalized'}</span></div>
        <div class="shot-data__terminal"><span>SQL / PARQUET</span><code>SELECT * FROM comunas</code><span class="shot-data__terminal-line"></span></div>
      </div>
    </div>
  )}

  {site.id === 'tooltician' && (
    <div class="shot-studio">
      <div class="shot-studio__nav"><b><span>✳</span> tooltician</b><small>{es ? 'SERVICIOS · TRABAJO' : 'SERVICES · WORK'}</small></div>
      <div class="shot-studio__body">
        <small>PYTHON / DATA / WEB</small>
        <strong>{es ? 'Sistemas que siguen funcionando.' : 'Systems that keep working.'}</strong>
        <p>{es ? 'Automatización. Datos. Diseño digital.' : 'Automation. Data. Digital experiences.'}</p>
        <span>{es ? 'Explorar casos' : 'Explore work'} ↗</span>
      </div>
      <div class="shot-studio__cards"><i>01 / AUTOMATION</i><i>02 / DATA</i><i>03 / WEB</i></div>
    </div>
  )}
</div>
<style>
.site-shot{--shot-accent:#f7ca56;position:relative;aspect-ratio:1.56;min-height:270px;overflow:hidden;isolation:isolate;background:#f4f1eb}
.site-shot__browser{height:30px;background:#161b26;color:#dce1e9;display:flex;align-items:center;gap:9px;padding:0 13px}
.site-shot__dots{display:flex;gap:4px}.site-shot__dots i{width:6px;height:6px;border-radius:50%;background:#485366}.site-shot__dots i:first-child{background:#c06b67}.site-shot__dots i:nth-child(2){background:#cfaa5b}.site-shot__dots i:last-child{background:#6c9d85}
.site-shot__url{font:500 10px/1.2 var(--ff-label);opacity:.76;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-left:auto}.site-shot__secure{font-size:11px;color:#aaa}
.site-shot>div:not(.site-shot__browser){height:calc(100% - 30px)}

/* Noticiencias: faithful news hierarchy — masthead, issue date, photo-led feature. */
.shot-news{background:#fafaf8;color:#182638;font-family:Arial,Helvetica,sans-serif;display:flex;flex-direction:column}
.shot-news__nav{height:38px;flex-shrink:0;display:flex;justify-content:space-between;align-items:center;gap:8px;border-bottom:2px solid #1e364e;padding:0 18px}
.shot-news__nav b{font:800 21px/1 Arial,Helvetica,sans-serif;letter-spacing:-.055em}
.shot-news__nav span{font:600 9px Arial,Helvetica,sans-serif;color:#52647a;white-space:nowrap}
.shot-news__edition{height:26px;flex-shrink:0;display:flex;align-items:center;justify-content:space-between;gap:6px;margin:0 18px;border-bottom:1px solid #d9dfe4;color:#245780;font:750 9px Arial,Helvetica,sans-serif;letter-spacing:.04em}
.shot-news__edition span:last-child{color:#647282;font-size:8px}
.shot-news__headline{flex-shrink:0;padding:11px 18px 10px}
.shot-news__headline strong{display:block;max-width:27ch;font:800 clamp(23px,2.65vw,31px)/1.02 Arial,Helvetica,sans-serif;letter-spacing:-.06em}
.shot-news__headline p{margin-top:5px;color:#61707c;font:400 10px/1.35 Arial,Helvetica,sans-serif}
.shot-news__feature{flex:1;min-height:0;display:grid;grid-template-columns:53% 47%;margin:0 18px 8px;border-top:1px solid #d9dfe4;overflow:hidden}
.shot-news__feature img{display:block;width:100%;height:100%;min-height:0;object-fit:cover;object-position:center 40%;padding-top:8px}
.shot-news__feature-copy{min-width:0;padding:12px 6px 0 13px;display:flex;flex-direction:column;gap:7px;align-items:flex-start}
.shot-news__feature-copy small{font:800 8px Arial,Helvetica,sans-serif;letter-spacing:.05em;color:#2a7296}
.shot-news__feature-copy b{font:750 clamp(13px,1.5vw,18px)/1.14 Arial,Helvetica,sans-serif;letter-spacing:-.045em}
.shot-news__feature-copy>span{font:700 8px Arial,Helvetica,sans-serif;color:#677482;margin-top:auto;padding-bottom:4px}
.shot-news__bottom{height:22px;flex-shrink:0;background:#edf2f5;border-top:1px solid #d8e0e7;display:flex;align-items:center;justify-content:space-between;gap:5px;padding:0 18px;color:#39596d;font:700 8px Arial,Helvetica,sans-serif;letter-spacing:.025em}
.shot-news__bottom span:last-child{font-weight:500;color:#61717c}

/* Monedario: own blue identity, Fraunces-style italic display, CTA rows and indicator strip. */
.shot-money{background:#f8f9fb;color:#1a2332;font-family:'Source Sans 3',Arial,sans-serif;display:flex;flex-direction:column}
.shot-money__nav{height:44px;flex-shrink:0;border-bottom:1px solid #c8d3e0;padding:0 18px;display:flex;align-items:center;justify-content:space-between;gap:8px}
.shot-money__brand{display:flex;align-items:center;gap:7px}
.shot-money__brand b{font:650 22px/1 Arial,Helvetica,sans-serif;letter-spacing:.005em;color:#1a2332}
.shot-money__nav>span{font:600 9px Arial,Helvetica,sans-serif;color:#51637a;white-space:nowrap}
.shot-money__mark{display:flex;align-items:center;justify-content:center;flex-direction:column;gap:2px;width:22px;height:22px}
.shot-money__mark i{display:block;background:#1a4f8a;border-radius:3px;height:5px}
.shot-money__mark i:nth-child(1){width:11px}.shot-money__mark i:nth-child(2){width:17px}.shot-money__mark i:nth-child(3){width:22px}
.shot-money__content{flex:1;min-height:0;display:grid;grid-template-columns:1.14fr .86fr;gap:15px;padding:17px 18px 8px}
.shot-money__hero{display:flex;flex-direction:column;align-items:flex-start;min-width:0}
.shot-money__hero>span{font:750 8px Arial,Helvetica,sans-serif;color:#1a4f8a;letter-spacing:.09em}
.shot-money__hero strong{display:block;margin-top:9px;font:700 clamp(24px,2.65vw,32px)/1.03 Georgia,'Times New Roman',serif;letter-spacing:-.045em}
.shot-money__hero strong em{font-weight:700;color:#1a4f8a}
.shot-money__hero p{font:400 11px/1.4 Arial,Helvetica,sans-serif;color:#59697c;margin-top:9px}
.shot-money__links{border-top:1px solid #c8d3e0;display:flex;flex-direction:column;justify-content:space-around;min-width:0}
.shot-money__links>span{border-bottom:1px solid #c8d3e0;display:flex;align-items:center;justify-content:space-between;gap:6px;padding:9px 4px;color:#1a4f8a;font:650 11px/1.25 Arial,Helvetica,sans-serif;text-decoration:underline;text-decoration-style:dashed;text-underline-offset:3px}
.shot-money__links b{font-size:15px;text-decoration:none}
.shot-money__indicators{border-block:1px solid #c8d3e0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));margin:0 18px}
.shot-money__indicator{min-width:0;display:flex;flex-direction:column;gap:4px;padding:8px 11px}
.shot-money__indicator:first-child{padding-left:0}.shot-money__indicator:not(:last-child){border-right:1px solid #c8d3e0}
.shot-money__indicator small{font:750 8px Arial,Helvetica,sans-serif;color:#63748a;letter-spacing:.05em}
.shot-money__indicator b{font:700 12px/1.1 Georgia,'Times New Roman',serif;color:#1a2332}
.shot-money__foot{flex-shrink:0;height:25px;display:flex;align-items:center;padding:0 18px;color:#536275;font:italic 10px Georgia,'Times New Roman',serif}
@media(max-width:520px){
  .shot-news__nav{padding-inline:12px;height:34px}.shot-news__nav b{font-size:18px}.shot-news__nav span{font-size:7px}
  .shot-news__edition{margin-inline:12px;height:22px;font-size:7px}.shot-news__edition span:last-child{font-size:7px}
  .shot-news__headline{padding:8px 12px 7px}.shot-news__headline strong{font-size:21px}.shot-news__headline p{font-size:8px}
  .shot-news__feature{margin:0 12px 6px;grid-template-columns:51% 49%}.shot-news__feature-copy{padding:8px 0 0 8px;gap:4px}
  .shot-news__feature-copy small,.shot-news__feature-copy>span{font-size:7px}.shot-news__feature-copy b{font-size:12px}
  .shot-news__bottom{height:20px;padding-inline:12px;font-size:7px}
  .shot-money__nav{height:37px;padding-inline:12px}.shot-money__brand b{font-size:18px}.shot-money__nav>span{font-size:7px}
  .shot-money__content{padding:10px 12px 5px;gap:9px}.shot-money__hero strong{font-size:22px;margin-top:7px}.shot-money__hero p{font-size:9px;margin-top:5px}
  .shot-money__links>span{font-size:9px;padding:7px 2px}.shot-money__indicators{margin-inline:12px}
  .shot-money__indicator{padding:6px 7px;gap:2px}.shot-money__indicator small{font-size:7px}.shot-money__indicator b{font-size:10px}
  .shot-money__foot{height:20px;padding-inline:12px;font-size:8px}
}

.shot-shop{background:#faf9f5;color:#272724;font-family:var(--ff-heading)}
.shot-shop__nav{height:46px;background:#173b2b;color:white;display:flex;justify-content:space-between;align-items:center;padding:0 20px;gap:8px}
.shot-shop__nav b{font-size:16px;letter-spacing:-.03em}.shot-shop__nav>span{font-size:10px}.shot-shop__nav i{display:inline-grid;place-items:center;border-radius:50%;background:#f2b761;color:#173b2b;width:17px;height:17px;font-style:normal;margin-left:5px;font-weight:bold}
.shot-shop__copy{padding:15px 21px 9px;display:flex;flex-direction:column;gap:6px}
.shot-shop__copy small{font:700 8px var(--ff-label);color:#49876a;letter-spacing:.08em}.shot-shop__copy strong{font-size:clamp(21px,3vw,31px);letter-spacing:-.05em}
.shot-shop__search{display:flex;justify-content:space-between;background:#fff;border:1px solid #d5dfd8;border-radius:6px;padding:7px 12px;color:#929d94;font-size:10px}.shot-shop__search span{color:#387b5b;font-size:15px}
.shot-shop__products{display:flex;gap:12px;padding:4px 21px 14px}
.shot-shop__product{background:#fff;border:1px solid #e4e7e1;border-radius:7px;min-width:0;flex:1;display:grid;grid-template-columns:1fr 21px;align-items:center;gap:2px;padding:7px}
.shot-shop__product img{display:block;width:100%;height:75px;object-fit:contain;grid-column:1/-1}.shot-shop__product b{font-size:10px}.shot-shop__product span{width:18px;height:18px;border-radius:4px;background:#1d714b;color:white;display:grid;place-items:center}
.shot-bakery{background:#f4e9de;color:#5c3025;font-family:var(--ff-heading)}
.shot-bakery__nav{display:flex;justify-content:space-between;align-items:center;height:47px;padding:0 20px;position:relative;z-index:1}
.shot-bakery__nav b{font-size:25px;letter-spacing:-.06em;font-family:Georgia,serif}.shot-bakery__nav b span{font-family:var(--ff-label);font-size:9px;vertical-align:top}
.shot-bakery__nav small{font:700 9px var(--ff-label);letter-spacing:.08em;color:#945f42}
.shot-bakery__body{height:calc(100% - 74px);display:grid;grid-template-columns:1fr 1.05fr;position:relative}
.shot-bakery__copy{padding:23px 0 0 23px;z-index:2;display:flex;align-items:flex-start;flex-direction:column;gap:9px}
.shot-bakery__copy small{font:700 9px var(--ff-label);letter-spacing:.07em;color:#a26748}
.shot-bakery__copy strong{font-family:Georgia,serif;font-size:clamp(24px,3.3vw,38px);letter-spacing:-.055em;line-height:1.04}
.shot-bakery__copy p{font-size:11px;color:#905d47;line-height:1.4}
.shot-bakery__copy>span{margin-top:auto;padding:7px 10px;background:#653c2b;color:white;border-radius:3px;font:600 10px var(--ff-label)}
.shot-bakery__body img{width:100%;height:100%;object-fit:cover;mask-image:linear-gradient(90deg,transparent 0%,black 20%)}
.shot-bakery__foot{height:27px;border-top:1px solid #d8bdae;display:flex;gap:12px;align-items:center;justify-content:space-around;font:600 8px var(--ff-label);letter-spacing:.12em;color:#8f5b41}
.shot-art{position:relative;background:#171818;color:#f8f5eb}
.shot-art__nav{height:43px;display:flex;align-items:center;justify-content:space-between;padding:0 18px;font:500 10px var(--ff-label);letter-spacing:.1em;gap:8px}
.shot-art__nav small{font-size:8px;color:#b2b5ac}
.shot-art__paintings{height:calc(100% - 98px);display:flex;justify-content:center;align-items:center;gap:17px;padding:2px 26px}
.shot-art__painting{height:100%;width:43%;min-width:0;background:#252525;padding:7px;box-shadow:0 4px 12px #0008}
.shot-art__painting--second{transform:translateY(9px)}
.shot-art__painting img{display:block;width:100%;height:100%;object-fit:contain}
.shot-art__caption{height:55px;display:flex;gap:5px;justify-content:center;align-items:center;flex-direction:column}
.shot-art__caption small{font:600 8px var(--ff-label);letter-spacing:.12em;color:#b6b39f}.shot-art__caption strong{font:italic 22px Georgia,serif;letter-spacing:-.035em}
.shot-data{background:linear-gradient(140deg,#0a2638,#11394d);color:#ecf8fb}
.shot-data__nav{height:45px;display:flex;justify-content:space-between;align-items:center;padding:0 21px;border-bottom:1px solid #ffffff24}
.shot-data__nav b{font:700 21px var(--ff-heading);letter-spacing:-.055em}.shot-data__nav b span{color:#69d0c9}.shot-data__nav small{font:600 8px var(--ff-label);letter-spacing:.05em;color:#9bbdc7}
.shot-data__heading{padding:16px 22px 11px;display:flex;flex-direction:column;gap:7px}
.shot-data__heading small{font:700 8px var(--ff-label);color:#70dacc;letter-spacing:.12em}
.shot-data__heading strong{font:700 clamp(18px,2.7vw,30px)/1.07 var(--ff-heading);letter-spacing:-.045em;max-width:24ch}
.shot-data__dashboard{display:grid;grid-template-columns:.65fr .65fr 1.15fr;gap:7px;padding:0 22px 15px}
.shot-data__dashboard>div{min-width:0;border:1px solid #ffffff28;background:#ffffff0c;border-radius:5px;padding:10px 9px;display:flex;flex-direction:column;gap:4px}
.shot-data__dashboard small{font:600 8px var(--ff-label);color:#9fc7d1}.shot-data__dashboard b{font:700 29px var(--ff-heading);letter-spacing:-.06em}.shot-data__dashboard span{font:500 8px var(--ff-label);color:#9fc7d1}
.shot-data__dashboard .shot-data__terminal{background:#091925}.shot-data__terminal>span:first-child{font-size:9px;color:#61d5b6}.shot-data__terminal code{margin-top:6px;white-space:nowrap;font:600 9px var(--ff-label);color:#e0e7ee}.shot-data__terminal-line{height:2px;width:75%;background:linear-gradient(90deg,#36d5aa,transparent);margin-top:auto}
.shot-studio{background:radial-gradient(circle at 95% 50%,#3f3a29,#0b1324 58%);color:#f1f5f9}
.shot-studio__nav{height:48px;display:flex;justify-content:space-between;align-items:center;padding:0 22px;border-bottom:1px solid #ffffff23}
