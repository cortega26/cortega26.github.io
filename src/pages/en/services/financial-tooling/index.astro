---
import ServicePage from '../../../../components/ServicePage.astro';
import { services } from '../../../../data/services';
import { alternatesFor } from '../../../../data/routes';
import '../../../../styles/global.css';

const def = services['financial-tooling'];
const canonical = 'https://tooltician.com/en/services/financial-tooling/';
const crossLocaleHref = '/es/servicios/herramientas-financieras/';
const alternates = alternatesFor('service:' + def.serviceKey);
---
<ServicePage
  lang="en"
  content={def.en}
  slug={def.slugEn}
  serviceKey={def.serviceKey}
  canonical={canonical}
  alternates={alternates}
  crossLocaleHref={crossLocaleHref}
  areaServed={def.areaServed}
/>
