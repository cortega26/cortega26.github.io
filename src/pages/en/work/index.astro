---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import PortfolioSection from '../../../components/PortfolioSection.astro';
import { alternatesFor } from '../../../data/routes';
import { buildBreadcrumb, buildPortfolioItemList, buildWorkCollection } from '../../../data/jsonld';
import { orderedCasesForWork } from '../../../data/caseStudies';
import '../../../styles/global.css';

const canonical = 'https://tooltician.com/en/work/';
const workJsonLd = buildWorkCollection('en', canonical);
const portfolioJsonLd = buildPortfolioItemList('en', orderedCasesForWork('en'));
const breadcrumbJsonLd = buildBreadcrumb([
  { name: 'Tooltician', item: 'https://tooltician.com/en/' },
  { name: 'Work', item: canonical },
]);

const navItems = [
  { href: '/en/#proof', label: 'Proof' },
  { href: '/en/#services', label: 'Services' },
  { href: '#portfolio', label: 'Work' },
  { href: '/en/#about', label: 'About' },
];
---
<BaseLayout
  title="Production Work & Case Studies | Tooltician"
  description="Ten production projects across Python automation, data pipelines, internal tools, financial controls, browser extensions, and focused front ends."
  lang="en"
  canonical="https://tooltician.com/en/work/"
  alternates={alternatesFor('work')}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(workJsonLd)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(portfolioJsonLd)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbJsonLd)} />
  </Fragment>

  <Navbar lang="en" items={navItems} ctaHref="/en/#contact" switchHref="/es/trabajo/" />
  <main id="main" class="portfolio-page">
    <PortfolioSection lang="en" full />
  </main>
  <Footer lang="en" />
</BaseLayout>

<style>
  .portfolio-page { padding-top: var(--nav-height); }
</style>
