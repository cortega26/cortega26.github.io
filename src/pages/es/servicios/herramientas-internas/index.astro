---
import ServicePage from '../../../../components/ServicePage.astro';
import { services } from '../../../../data/services';
import { alternatesFor } from '../../../../data/routes';
import '../../../../styles/global.css';

const def = services['internal-tools'];
const canonical = 'https://tooltician.com/es/servicios/herramientas-internas/';
const crossLocaleHref = '/en/services/internal-tools/';
const alternates = alternatesFor('service:' + def.serviceKey);
---
<ServicePage
  lang="es"
  content={def.es}
  slug={def.slugEs}
  serviceKey={def.serviceKey}
  canonical={canonical}
  alternates={alternates}
  crossLocaleHref={crossLocaleHref}
  areaServed={def.areaServed}
/>
