---
import ServicePage from '../../../../components/ServicePage.astro';
import { services } from '../../../../data/services';
import { alternatesFor } from '../../../../data/routes';
import '../../../../styles/global.css';

const def = services['recurring-data'];
const canonical = 'https://tooltician.com/es/servicios/recoleccion-recurrente-datos/';
const crossLocaleHref = '/en/services/recurring-data-collection/';
const alternates = alternatesFor('service:' + def.serviceKey);
---
<ServicePage lang="es" content={def.es} slug={def.slugEs} serviceKey={def.serviceKey} canonical={canonical} alternates={alternates} crossLocaleHref={crossLocaleHref} areaServed={def.areaServed} />
