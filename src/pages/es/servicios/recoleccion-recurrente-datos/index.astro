---
import ServicePage from '../../../../components/ServicePage.astro';
import { services } from '../../../../data/services';
import { alternatesFor, routeGroup } from '../../../../data/routes';
import '../../../../styles/global.css';

const def = services['recurring-data'];
const group = routeGroup('service:' + def.serviceKey);
const canonical = `https://tooltician.com${group.paths.es}`;
const crossLocaleHref = group.paths.en ?? '/en/';
const alternates = alternatesFor('service:' + def.serviceKey);
---
<ServicePage lang="es" content={def.es} slug={def.slugEs} serviceKey={def.serviceKey} canonical={canonical} alternates={alternates} crossLocaleHref={crossLocaleHref} areaServed={def.areaServed} />
