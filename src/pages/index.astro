---
import serviceRegistry from '../data/service-registry.json';
import { alternatesFor } from '../data/routes';
import { buildOrganization, buildWebSite } from '../data/jsonld';

const ga4Id = import.meta.env.PUBLIC_GA4_MEASUREMENT_ID as string | undefined;

const services = serviceRegistry.services;

const websiteJsonLd = buildWebSite();
const organizationJsonLd = buildOrganization();

const proofLinks = [
  { label: 'elrincondeebano.com', href: 'https://elrincondeebano.com', detail: 'live store · daily orders' },
  { label: 'monedario.cl', href: 'https://monedario.cl', detail: 'public finance product' },
  { label: 'bankrecon on PyPI', href: 'https://pypi.org/project/bankrecon/', detail: 'fail-closed reconciliation' },
  { label: 'chile-hub on GitHub', href: 'https://github.com/cortega26/chile-hub', detail: 'data pipelines & CLI' },
];
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tooltician — Python Automation Consultant | English / Español</title>
  <meta name="description" content="Tooltician automates reporting, ETL, and internal workflows that survive handoff. English and Spanish services, public production evidence, and a direct project brief." />
  <link rel="canonical" href="https://tooltician.com/" />
  {alternatesFor('home').map((alternate) => (
    <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
  ))}
  <meta name="robots" content="index, follow" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Tooltician" />
  <meta property="og:title" content="Tooltician — Python Automation Consultant | English / Español" />
  <meta property="og:description" content="Automation, data pipelines, internal tools, and web hygiene. English and Spanish services with public production evidence." />
  <meta property="og:url" content="https://tooltician.com/" />
  <meta property="og:image" content="https://tooltician.com/assets/images/og-card.png" />
  <meta property="og:image:alt" content="Tooltician preview card" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Tooltician — Python Automation Consultant | English / Español" />
  <meta name="twitter:description" content="Automation, data pipelines, internal tools, and web hygiene. English and Spanish services with public production evidence." />
  <meta name="twitter:image" content="https://tooltician.com/assets/images/og-card.png" />
  <meta name="twitter:image:alt" content="Tooltician preview card" />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
  <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
  <meta name="theme-color" content="#0b1121" />
  <link rel="preload" href="/fonts/archivo-variable.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/jetbrains-mono-variable.woff2" as="font" type="font/woff2" crossorigin />
  {ga4Id && <script is:inline src="/assets/js/analytics-guard.js" data-ga4-id={ga4Id}></script>}
  {ga4Id && (
    <>
      <link rel="preconnect" href="https://www.googletagmanager.com" />
      <link rel="preconnect" href="https://www.google-analytics.com" />
    </>
  )}
  <script type="application/ld+json" is:inline set:html={JSON.stringify(websiteJsonLd)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(organizationJsonLd)} />
  <script is:inline src="/assets/js/root-language-redirect.js"></script>
  <style>
    :root {
      color-scheme: dark;
      --bg: #0b1121;
      --surface: rgba(255, 255, 255, 0.03);
      --border: rgba(148, 163, 184, 0.12);
      --text: #f1f5f9;
      --muted: #94a3b8;
      --faint: #64748b;
      --accent: #c4a04a;
      --ff-body: 'Archivo', system-ui, sans-serif;
      --ff-heading: 'Archivo', system-ui, sans-serif;
      --ff-label: 'JetBrains Mono', ui-monospace, monospace;
    }

    @font-face {
      font-family: 'Archivo';
      src: url('/fonts/archivo-variable.woff2') format('woff2');
      font-style: normal;
      font-weight: 100 900;
      font-display: swap;
    }

    @font-face {
      font-family: 'JetBrains Mono';
      src: url('/fonts/jetbrains-mono-variable.woff2') format('woff2');
      font-style: normal;
      font-weight: 100 800;
      font-display: swap;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      min-height: 100vh;
      font-family: var(--ff-body);
      color: var(--text);
      background: var(--bg);
      padding: 2.5rem 1.5rem 3rem;
    }

    ::selection {
      background: rgba(196, 160, 74, 0.25);
      color: var(--text);
    }

    .landing {
      width: min(100%, 980px);
      margin: 0 auto;
      display: grid;
      gap: 2.25rem;
    }

    .landing__header {
      display: flex;
      align-items: center;
      gap: 0.85rem;
    }

    .landing__logo {
      width: 40px;
      height: 40px;
      flex-shrink: 0;
    }

    .landing__brand {
      display: grid;
      gap: 0.1rem;
    }

    .landing__brand-name {
      font-family: var(--ff-heading);
      font-size: 1.25rem;
      font-weight: 700;
      letter-spacing: -0.03em;
      line-height: 1;
    }

    .landing__brand-tag {
      font-family: var(--ff-label);
      font-size: 0.6rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--accent);
      opacity: 0.7;
    }

    .landing__title {
      margin: 0;
      font-family: var(--ff-heading);
      font-size: clamp(1.75rem, 4.5vw, 2.75rem);
      line-height: 1.02;
      letter-spacing: -0.035em;
    }

    .landing__title span {
      display: block;
    }

    .landing__title span + span {
      color: var(--muted);
      font-size: 0.68em;
      margin-top: 0.35rem;
    }

    .landing__lede {
      margin: 0;
      color: var(--muted);
      font-size: 0.95rem;
      line-height: 1.7;
      max-width: 68ch;
    }

    .landing__langs {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.75rem;
    }

    .lang-card {
      display: block;
      padding: 1.1rem 1.25rem;
      border: 1px solid var(--border);
      border-radius: 6px;
      background: var(--surface);
      color: inherit;
      text-decoration: none;
      transition: border-color 200ms, background 200ms;
    }

    .lang-card:hover,
    .lang-card:focus-visible {
      border-color: rgba(196, 160, 74, 0.25);
      background: rgba(196, 160, 74, 0.04);
      outline: none;
    }

    .lang-card strong {
      display: block;
      margin-bottom: 0.35rem;
      font-family: var(--ff-heading);
      font-size: 1.05rem;
      font-weight: 700;
    }

    .lang-card span {
      color: var(--muted);
      line-height: 1.55;
      font-size: 0.85rem;
      display: block;
    }

    .landing__section {
      display: grid;
      gap: 0.85rem;
    }

    .landing__section-title {
      margin: 0;
      font-family: var(--ff-label);
      font-size: 0.68rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--faint);
    }

    .proof-list {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .proof-list a {
      display: inline-flex;
      align-items: baseline;
      gap: 0.45rem;
      padding: 0.45rem 0.75rem;
      border: 1px solid var(--border);
      border-radius: 6px;
      background: var(--surface);
      color: var(--text);
      text-decoration: none;
      font-size: 0.85rem;
      font-weight: 600;
      transition: border-color 150ms, background 150ms;
    }

    .proof-list a:hover {
      border-color: rgba(196, 160, 74, 0.3);
      background: rgba(196, 160, 74, 0.05);
    }

    .proof-list a span {
      color: var(--faint);
      font-family: var(--ff-label);
      font-size: 0.66rem;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .services-columns {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }

    .service-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: 0.45rem;
      border: 1px solid var(--border);
      border-radius: 6px;
      background: var(--surface);
      padding: 1rem 1.15rem;
    }

    .service-list__lang {
      font-family: var(--ff-label);
      font-size: 0.62rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--accent);
      opacity: 0.75;
      margin-bottom: 0.15rem;
    }

    .service-list a {
      color: var(--muted);
      text-decoration: none;
      font-size: 0.9rem;
      line-height: 1.5;
      transition: color 150ms;
    }

    .service-list a:hover {
      color: var(--text);
    }

    .landing__ctas {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0.7rem 1.15rem;
      border-radius: 6px;
      font-family: var(--ff-body);
      font-size: 0.9rem;
      font-weight: 600;
      text-decoration: none;
      border: 1px solid transparent;
      transition: background 150ms, border-color 150ms, color 150ms;
    }

    .btn--primary {
      background: var(--accent);
      color: #0b1121;
    }

    .btn--primary:hover {
      background: #d4b25c;
    }

    .btn--ghost {
      border-color: var(--border);
      color: var(--text);
      background: var(--surface);
    }

    .btn--ghost:hover {
      border-color: rgba(196, 160, 74, 0.3);
    }

    .landing__footer {
      color: var(--faint);
      font-family: var(--ff-label);
      font-size: 0.66rem;
      letter-spacing: 0.04em;
      line-height: 1.6;
    }

    @media (max-width: 700px) {
      .landing__langs,
      .services-columns {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body>
  <main class="landing">
    <header class="landing__header">
      <img class="landing__logo" src="/assets/images/tooltician-logo-128.webp" alt="" width="40" height="40" decoding="async">
      <div class="landing__brand">
        <span class="landing__brand-name">Tooltician</span>
        <span class="landing__brand-tag">Automation systems</span>
      </div>
    </header>

    <h1 class="landing__title">
      <span lang="en">Reliable operational systems.</span>
      <span lang="es">Sistemas operativos confiables.</span>
    </h1>

    <p class="landing__lede" lang="en">
      I replace recurring manual work, fragile data flows, and hard-to-own internal processes
      with systems your team can run, inspect, and hand off.
    </p>
    <p class="landing__lede" lang="es">
      Reemplazo trabajo manual recurrente, flujos de datos frágiles y procesos internos difíciles
      de mantener por sistemas que tu equipo puede operar, revisar y traspasar.
    </p>

    <div class="landing__langs">
      <a class="lang-card" href="/en/" data-language-preference="en" data-language-select>
        <strong>English</strong>
        <span>Proof, production work, and a direct project brief.</span>
      </a>
      <a class="lang-card" href="/es/" data-language-preference="es" data-language-select>
        <strong>Español</strong>
        <span>Evidencia pública, trabajo en producción y brief directo.</span>
      </a>
    </div>

    <section class="landing__section" aria-labelledby="landing-proof">
      <h2 class="landing__section-title" id="landing-proof">Public proof / Evidencia pública</h2>
      <ul class="proof-list">
        {proofLinks.map((link) => (
          <li>
            <a href={link.href} target="_blank" rel="noopener noreferrer">
              {link.label} <span>{link.detail}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="landing__section" aria-labelledby="landing-services">
      <h2 class="landing__section-title" id="landing-services">Services / Servicios</h2>
      <div class="services-columns">
        <ul class="service-list" lang="en">
          <li class="service-list__lang">English</li>
          {services.map((service) => (
            <li><a href={service.route_en}>{service.public_name}</a></li>
          ))}
        </ul>
        <ul class="service-list" lang="es">
          <li class="service-list__lang">Español</li>
          {services.map((service) => (
            <li><a href={service.route_es}>{service.public_name_es}</a></li>
          ))}
        </ul>
      </div>
    </section>

    <div class="landing__ctas">
      <a class="btn btn--primary" href="/en/#contact" data-track="cta_send_brief" data-track-loc="root_landing">Send a written brief</a>
      <a class="btn btn--primary" href="/es/#contact" data-track="cta_send_brief" data-track-loc="root_landing">Enviar brief</a>
      <a class="btn btn--ghost" href="https://calendly.com/ciortega26" target="_blank" rel="noopener noreferrer" data-track="cta_book_call" data-track-loc="root_landing" data-book-call>Book a 15-min call</a>
    </div>

    <p class="landing__footer">
      Santiago, Chile · EN / ES · Fixed-scope engagements with documented handoff.
    </p>
  </main>
  <script is:inline src="/assets/js/root-language-picker.js" defer></script>
  <script is:inline src="/assets/js/track.js" defer></script>
  <script is:inline src="/assets/js/product-analytics.js" defer></script>

  <!-- GA4 (gtag.js direct — inline stub síncrono ANTES de async gtag.js, Plan 006) -->
  <!-- cookie_expires: 60*60*24*395 = 34128000s = 395 días ≈13 meses (API solo soporta segundos, sin precisión calendárica) -->
  {ga4Id && (
    <script is:inline define:vars={{ ga4Id }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      window.gtag = gtag;
      gtag('js', new Date());
      gtag('config', ga4Id, { send_page_view: true, cookie_expires: 60 * 60 * 24 * 395 });
    </script>
  )}
  {ga4Id && (
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`}></script>
  )}
</body>
</html>
