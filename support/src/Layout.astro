---
import './styles.css';
import { business, neighborOffer } from './config';
interface Props {
  title: string;
  description: string;
  variant?: 'default' | 'neighbors' | 'flyer';
  forceNoindex?: boolean;
}
const {
  title,
  description,
  variant = 'default',
  forceNoindex = false,
} = Astro.props;
const neighbors = variant === 'neighbors';
const flyer = variant === 'flyer';
const canonical = new URL(Astro.url.pathname, business.origin).href;
const released = __SUPPORT_RELEASE__;
const phone = `+${business.whatsapp}`;
const socialImage = `${business.origin}/og-card-v2.png`;
const socialTitle = !neighbors && !flyer ? '¿Tu computador está lento o fallando? | Tooltician Soporte' : title;
const socialDescription = !neighbors && !flyer ? 'Soporte técnico para PC y notebooks en Macul, Ñuñoa y Providencia. Visitas desde $30.000, diagnóstico claro y precios antes de cualquier trabajo.' : description;
const sectionBase = neighbors ? '/vecinos/' : '/';
const brandSubtitle = neighbors ? 'SOPORTE PARA VECINOS' : flyer ? 'SOPORTE EN TU BARRIO' : 'SOPORTE A DOMICILIO';
const socialAlt = neighbors
  ? `${business.name}: soporte técnico exclusivo para vecinos del edificio.`
  : `${business.name}: ¿Tu computador está lento o fallando? Soporte técnico a domicilio en Macul, Ñuñoa y Providencia. Atención personal por Carlos Ortega.`;
// Organization on purpose: neither offer publishes a residential address.
// The neighbors variant is evaluation-only, so it does not advertise a public
// service area in structured data.
const schema = neighbors
  ? {
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: business.name,
      description,
      url: canonical,
      logo: `${business.origin}/favicon.svg`,
      image: socialImage,
      email: business.email,
      telephone: phone,
      founder: {
        '@type': 'Person',
        name: business.owner,
        jobTitle: 'Soporte técnico de computadores',
        sameAs: [business.parent, business.github, business.linkedin],
      },
      sameAs: [business.parent, business.github, business.linkedin],
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: business.name,
      description,
      url: business.origin,
      logo: `${business.origin}/favicon.svg`,
      image: socialImage,
      email: business.email,
      telephone: phone,
      founder: {
        '@type': 'Person',
        name: business.owner,
        jobTitle: 'Soporte técnico a domicilio',
        sameAs: [business.parent, business.github, business.linkedin],
      },
      contactPoint: [
        {
          '@type': 'ContactPoint',
          contactType: 'customer service',
          telephone: phone,
          email: business.email,
          availableLanguage: 'es-CL',
          areaServed: business.areas.map((area) => area.name),
        },
      ],
      areaServed: business.areas.map((area) => ({
        '@type': 'AdministrativeArea',
        name: area.name,
      })),
      sameAs: [business.parent, business.github, business.linkedin],
    };
---
<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title><meta name="description" content={description} />
    <link rel="canonical" href={canonical} /><link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="robots" content={released && !forceNoindex ? 'index, follow' : 'noindex, nofollow'} />
    <meta name="theme-color" content="#172b29" />
    <meta property="og:type" content="website" /><meta property="og:locale" content="es_CL" />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:title" content={socialTitle} /><meta property="og:description" content={socialDescription} />
    <meta property="og:url" content={canonical} /><meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} /><meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={socialTitle} /><meta name="twitter:description" content={socialDescription} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialAlt} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
  </head>
  <body>
    <a class="skip" href="#main">Ir al contenido</a>
    {neighbors
      ? <div class="preview-notice">{neighborOffer.consultationsOpen
          ? 'Consultas abiertas para vecinos · La recepción de equipos requiere confirmar las condiciones aplicables'
          : 'Vista previa · Variante para evaluación, todavía no disponible'}</div>
      : !released && <div class="preview-notice">Vista previa · Servicio aún no abierto a reservas</div>}
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={sectionBase} aria-label={neighbors ? 'Tooltician Soporte para vecinos, inicio' : 'Tooltician Soporte a domicilio, inicio'}><img class="brand-mark" src="/tooltician-logo-64.webp" srcset="/tooltician-logo-64.webp 1x, /tooltician-logo-128.webp 2x" alt="" width="41" height="41" decoding="async" /><span>tooltician<span class="brand-sub">{brandSubtitle}</span></span></a>
        {!flyer && <nav aria-label="Principal"><a href={`${sectionBase}#servicios`}>Servicios</a><a href={`${sectionBase}#precios`}>Precios</a><a href={neighbors ? '/vecinos/#como-funciona' : '/#cobertura'}>{neighbors ? 'Cómo funciona' : 'Cobertura'}</a></nav>}
        {!flyer && <a class="button small header-cta" href={`${sectionBase}#consulta`} data-cta="header">Consultar <span aria-hidden="true">↗</span></a>}
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer"><div class="container footer-grid">
      <div><a class="brand footer-brand" href="/">tooltician <span>soporte</span></a><p>Tecnología que vuelve a acompañarte.</p><p>{business.availability}</p></div>
      <div><a href="/privacidad/">Privacidad y datos</a>{!neighbors && <a href="/condiciones-del-servicio/">Condiciones del servicio</a>}<a href={business.parent}>Conoce Tooltician ↗</a>{business.email && <a href={`mailto:${business.email}`}>{business.email}</a>}</div>
      <p class="footer-note">© {new Date().getFullYear()} {business.name}<br />{neighbors ? 'Exclusivo para vecinos del edificio' : 'Macul · Ñuñoa · Providencia'}</p>
    </div></footer>
    {business.analyticsId && <aside class="consent container" aria-label="Medición opcional">
      <p>Medición opcional para saber qué secciones ayudan. No incluye lo que escribas en tu consulta. <a href="/privacidad/">Privacidad y medición</a></p>
      <div><button type="button" data-consent="yes">Permitir medición</button><button type="button" data-consent="no">Sin medición</button></div>
      <p id="consent-status" role="status"></p>
    </aside>}
    <script>
      import { enableAnalytics, disableAnalytics } from './lib/analytics';
      const key = 'support-analytics-consent-v1';
      let choice: string | null = null;
      try { choice = localStorage.getItem(key); } catch { /* Consent defaults to off. */ }
      if (choice === 'yes') enableAnalytics();
      document.querySelectorAll<HTMLButtonElement>('[data-consent]').forEach(button => button.addEventListener('click', () => {
        const next = button.dataset['consent'] ?? 'no';
        let saved = false;
        try { localStorage.setItem(key, next); saved = true; } catch { /* Still support this page. */ }
        if (next === 'yes') enableAnalytics();
        else { disableAnalytics(); if (saved) location.reload(); }
        const status = document.querySelector('#consent-status');
        if (status) status.textContent = next === 'yes' ? 'Medición activada. Puedes desactivarla aquí.' : 'Medición desactivada.';
      }));
    </script>
  </body>
</html>
